/* Root container */
.runtimeflow-dashboard-root {
    flex-grow: 1;
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-size: 12px;
}

/* Header & Toolbar */
.rf-toolbar {
    height: 32px;
    background-color: #252526;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
}

.rf-toolbar-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #4ec9b0;
    margin-right: 12px;
}

.rf-mode-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.rf-mode-badge--play {
    background-color: #1e5c2b;
    color: #a8ffb2;
}

.rf-mode-badge--edit {
    background-color: #3b3b3c;
    color: #dcdcdc;
}

.rf-tab-button {
    height: 24px;
    padding: 2px 10px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: #2d2d30;
    color: #cccccc;
    border-width: 1px;
    border-color: #3e3e42;
}

.rf-tab-button:hover {
    background-color: #3e3e42;
    color: #ffffff;
}

.rf-tab-button--active {
    background-color: #0e639c;
    color: #ffffff;
    border-color: #1177bb;
    -unity-font-style: bold;
}

.rf-search-field {
    flex-grow: 1;
    max-width: 240px;
    margin-left: auto;
    margin-right: 8px;
}

.rf-action-button {
    height: 24px;
    padding: 2px 8px;
    margin-left: 4px;
    background-color: #333337;
    border-color: #434346;
    border-radius: 3px;
    color: #dddddd;
}

.rf-action-button:hover {
    background-color: #3e3e42;
    color: #ffffff;
}

.rf-action-button--primary {
    background-color: #007acc;
    color: #ffffff;
    border-color: #0098ff;
}

/* Split view & Panes */
.rf-split-view {
    flex-grow: 1;
}

.rf-pane-left {
    min-width: 220px;
    background-color: #252526;
    border-right-width: 1px;
    border-right-color: #333333;
    padding: 6px;
}

.rf-pane-right {
    flex-grow: 1;
    background-color: #1e1e1e;
    padding: 12px;
}

/* Cards & Section Boxes */
.rf-card {
    background-color: #252526;
    border-width: 1px;
    border-color: #333333;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
}

.rf-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #569cd6;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: #333333;
    padding-bottom: 4px;
}

/* Property Rows */
.rf-property-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.rf-property-label {
    color: #9cdcfe;
    font-size: 11px;
}

.rf-property-value {
    color: #d4d4d4;
    font-size: 11px;
    -unity-font-style: bold;
}

/* Status Badges */
.rf-badge {
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 10px;
    -unity-font-style: bold;
}

.rf-badge--green {
    background-color: #1e5c2b;
    color: #85e89d;
}

.rf-badge--yellow {
    background-color: #5c4e1e;
    color: #ffea7f;
}

.rf-badge--red {
    background-color: #5c1e1e;
    color: #fdaeb7;
}

.rf-badge--blue {
    background-color: #1e3a5c;
    color: #79b8ff;
}

.rf-badge--gray {
    background-color: #333333;
    color: #888888;
}

/* List Items */
.rf-list-item {
    padding: 6px 8px;
    border-radius: 4px;
    margin-bottom: 2px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.rf-list-item:hover {
    background-color: #2a2d2e;
}

.rf-list-item--selected {
    background-color: #094771;
    color: #ffffff;
}

.rf-item-name {
    font-size: 12px;
    -unity-font-style: bold;
}

.rf-item-desc {
    font-size: 10px;
    color: #888888;
}

/* Status Bar */
.rf-status-bar {
    height: 22px;
    background-color: #007acc;
    color: #ffffff;
    font-size: 11px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* ---------------------------------------------------------------- 1.0 dashboard */

.rf-tab-bar {
    flex-direction: row;
    margin-left: auto;
}

.rf-host-dropdown {
    min-width: 160px;
    margin-right: 6px;
}

.rf-version-label {
    font-size: 10px;
    color: #eaf6ff;
}

.rf-filter-field {
    margin-bottom: 6px;
}

.rf-graph-top {
    flex-grow: 1;
    min-height: 160px;
}

.rf-hint {
    font-size: 11px;
    color: #8a9199;
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Service rows */

.rf-row-body {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.rf-group-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: #4ec9b0;
    background-color: #2d2d30;
    padding-left: 4px;
    padding-right: 4px;
}

.rf-item-metric {
    font-size: 10px;
    color: #d4d4d4;
    margin-left: 6px;
    min-width: 52px;
    -unity-text-align: middle-right;
}

.rf-dependency-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.rf-scope-card {
    margin-right: 4px;
}

.rf-scope-services {
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: #333333;
}

.rf-progress {
    height: 16px;
    margin-top: 6px;
}

/* State badges */

.rf-badge {
    min-width: 66px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.rf-state--pending {
    background-color: #333333;
    color: #9aa0a6;
}

.rf-state--running {
    background-color: #1e3a5c;
    color: #79b8ff;
}

.rf-state--awaiting {
    background-color: #4a3a12;
    color: #ffd479;
}

.rf-state--completed {
    background-color: #1e5c2b;
    color: #85e89d;
}

.rf-state--degraded {
    background-color: #5c4e1e;
    color: #ffea7f;
}

.rf-state--failed {
    background-color: #5c1e1e;
    color: #fdaeb7;
}

.rf-state--cancelled {
    background-color: #4a2b4a;
    color: #e6b3e6;
}

.rf-state--skipped {
    background-color: #2b2b2b;
    color: #767676;
}

/* Failure cards */

.rf-card--failed {
    border-color: #a33a3a;
    background-color: #2a1e1e;
}

.rf-card--degraded {
    border-color: #a3862f;
    background-color: #2a271e;
}

.rf-error-message {
    white-space: normal;
    color: #f5c2c7;
    font-size: 11px;
    margin-bottom: 6px;
}

.rf-stack {
    min-height: 90px;
    max-height: 220px;
    font-size: 10px;
    margin-top: 4px;
}

.rf-stack > .unity-text-field__input {
    background-color: #1b1b1b;
    color: #c8c8c8;
    border-color: #333333;
    white-space: normal;
}

/* Timeline */

.rf-timeline {
    height: 150px;
    border-top-width: 1px;
    border-top-color: #333333;
    background-color: #202021;
    padding: 6px;
}

.rf-timeline-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

.rf-timeline-name {
    width: 150px;
    font-size: 10px;
    color: #cccccc;
    overflow: hidden;
}

.rf-timeline-track {
    flex-grow: 1;
    height: 10px;
    background-color: #2b2b2d;
    border-radius: 2px;
}

.rf-timeline-bar {
    position: absolute;
    height: 10px;
    border-radius: 2px;
    min-width: 2px;
}

.rf-timeline-elapsed {
    width: 60px;
    font-size: 10px;
    color: #9aa0a6;
    -unity-text-align: middle-right;
}
